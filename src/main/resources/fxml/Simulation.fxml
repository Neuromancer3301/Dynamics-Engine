<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" styleClass="simulation-root"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.SimulationController">

    <top>
        <HBox styleClass="sim-title-bar" alignment="CENTER_LEFT" spacing="12.0">
            <padding>
                <Insets top="6" right="12" bottom="6" left="6"/>
            </padding>
            <Button fx:id="btnBack" styleClass="back-button" text="← Menu" onAction="#handleBack"/>
            <Label fx:id="titleLabel" styleClass="sim-title" text="N-Pendulum Chain Simulator"/>
        </HBox>
    </top>

    <!--
        Slim, always-present left action rail (Select / Add / Snap-to-Unit —
        see ui.icon.Icons and controller.SimulationController#buildActionRail).
        A genuine BorderPane.left column, not a floating overlay: at its
        fixed ~52px width it never risks occluding a bob swinging near the
        canvas's left edge the way an overlay could.
    -->
    <left>
        <VBox fx:id="actionRail" styleClass="action-rail" alignment="TOP_CENTER" spacing="6.0"/>
    </left>

    <center>
        <!--
            canvasGraphStack layers the small overlay sidebar-toggle button
            (top-right corner; see SimulationController#buildSidebarToggle)
            over canvasHost/graphHost — a StackPane, not part of the title
            bar, per the layout spec.
        -->
        <StackPane fx:id="canvasGraphStack" BorderPane.alignment="CENTER">
            <HBox fx:id="canvasGraphRow" spacing="0">
                <!--
                    minWidth/prefWidth are pinned to 0 rather than left to the
                    default "size to children" computation. The host contains an
                    unmanaged Canvas (see SimulationController) specifically so
                    it can never contribute to this number, but pinning it here
                    too means a future child added to either host can't silently
                    reintroduce the same overflow-off-screen failure mode.

                    graphHost's width is driven entirely by an animated
                    min/pref/max width (see SimulationController#setGraphVisible)
                    rather than HBox.hgrow, so it can sit at exactly 0px by
                    default (hidden) and a fixed slice of width once a graph
                    mode is selected, independent of window size; canvasHost
                    keeps ALWAYS growth so it always claims whatever's left.
                -->
                <StackPane fx:id="canvasHost" styleClass="canvas-host"
                           minWidth="0.0" prefWidth="0.0" HBox.hgrow="ALWAYS"/>
                <StackPane fx:id="graphHost" styleClass="canvas-host"
                           minWidth="0.0" prefWidth="0.0" maxWidth="0.0" HBox.hgrow="NEVER"/>
            </HBox>
        </StackPane>
    </center>

    <right>
        <!--
            sidebarToggleHost + sidebarScroll, side by side in one HBox with
            no spacing — round 1.5 §1: the toggle button used to be a
            fixed-margin overlay on canvasGraphStack, which looked attached
            to the sidebar only by coincidence (its margin happened to match
            the gap to the window edge while the sidebar was collapsed) and
            visibly detached into a floating chip the moment the sidebar
            actually expanded, since the overlay's position never tracked
            the sidebar's own animated width. Making the toggle a sibling
            column of sidebarScroll instead — both real layout children of
            this same HBox — means it is *structurally* always flush against
            whichever edge is currently the sidebar's own (the window edge
            while collapsed, the panel's edge once expanded), with zero
            special-casing: an HBox simply never leaves a gap between
            adjacent children.
        -->
        <HBox spacing="0.0">
            <VBox fx:id="sidebarToggleHost" styleClass="sidebar-toggle-host" alignment="TOP_CENTER"/>
            <!--
                ControlPanel and LinkEditorPanel are both plain-Java Regions
                (see controller.SimulationController) stacked inside this VBox;
                the ScrollPane exists because the link editor's row count is
                unbounded — without it, editing a 20-link chain would push
                content below the window with no way to reach it.

                Collapsed to zero width by default (see
                SimulationController#setSidebarExpanded) — canvas-first per the
                layout spec — and animated open/closed via min/pref/maxWidth,
                never setVisible(false), so it's a genuine layout column that
                shrinks the canvas/graph rather than overlaying them.
            -->
            <ScrollPane fx:id="sidebarScroll" styleClass="sidebar-scroll" fitToWidth="true" hbarPolicy="NEVER"
                        minWidth="0.0" prefWidth="0.0" maxWidth="0.0" HBox.hgrow="NEVER">
                <content>
                    <VBox fx:id="controlHost"/>
                </content>
            </ScrollPane>
        </HBox>
    </right>

</BorderPane>
