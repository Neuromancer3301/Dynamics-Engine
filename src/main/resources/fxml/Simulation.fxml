<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" styleClass="simulation-root"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.SimulationController">

    <top>
        <HBox styleClass="sim-title-bar" alignment="CENTER_LEFT" spacing="12.0">
            <padding>
                <Insets top="6" right="12" bottom="6" left="6"/>
            </padding>
            <Button fx:id="btnBack" styleClass="back-button" text="← Menu" onAction="#handleBack"/>
            <Label fx:id="titleLabel" styleClass="sim-title" text="N-Pendulum Chain Simulator"/>
        </HBox>
    </top>

    <center>
        <!--
            A GridPane with explicit percentages rather than an HBox: two
            hgrow="ALWAYS" children split leftover space *equally*, which
            is what pinned this to 50/50 before. Percentages express the
            intended 60/40 ratio directly — the pendulum is the thing being
            watched, and PendulumCanvas's render scale is width-limited in a
            typical window (see its coordinate-mapping comment), so the
            extra width becomes a visibly larger pendulum rather than
            padding. Not pushed further than 60 because GraphPanel's axis
            gutters (MARGIN) grew with its labels, and the plot area is
            what's left over after subtracting them.
        -->
        <GridPane BorderPane.alignment="CENTER">
            <columnConstraints>
                <!--
                    minWidth=0 for the same reason the hosts below pin it:
                    without it a column refuses to shrink past its content's
                    minimum and pushes the layout off-screen.
                -->
                <ColumnConstraints percentWidth="60.0" minWidth="0.0"/>
                <ColumnConstraints percentWidth="40.0" minWidth="0.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS"/>
            </rowConstraints>

            <!--
                minWidth/prefWidth are pinned to 0 rather than left to the
                default "size to children" computation. The host contains an
                unmanaged Canvas (see SimulationController) specifically so
                it can never contribute to this number, but pinning it here
                too means a future child added to either host can't silently
                reintroduce the same overflow-off-screen failure mode.
            -->
            <StackPane fx:id="canvasHost" styleClass="canvas-host"
                       minWidth="0.0" prefWidth="0.0"
                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <StackPane fx:id="graphHost" styleClass="canvas-host"
                       minWidth="0.0" prefWidth="0.0"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        </GridPane>
    </center>

    <right>
        <!--
            ControlPanel and LinkEditorPanel are both plain-Java Regions
            (see controller.SimulationController) stacked inside this VBox;
            the ScrollPane exists because the link editor's row count is
            unbounded — without it, editing a 20-link chain would push
            content below the window with no way to reach it.
        -->
        <ScrollPane styleClass="sidebar-scroll" fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox fx:id="controlHost"/>
            </content>
        </ScrollPane>
    </right>

</BorderPane>
