<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" styleClass="simulation-root"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.BoidsController">

    <top>
        <HBox styleClass="sim-title-bar" alignment="CENTER_LEFT" spacing="12.0">
            <padding>
                <Insets top="6" right="12" bottom="6" left="6"/>
            </padding>
            <Button fx:id="btnBack" styleClass="back-button" text="← Menu" onAction="#handleBack"/>
            <Label fx:id="titleLabel" styleClass="sim-title" text="Boids Flocking Simulator"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="canvasGraphStack" BorderPane.alignment="CENTER">
            <HBox fx:id="canvasGraphRow" spacing="0">
                <StackPane fx:id="canvasHost" styleClass="canvas-host"
                           minWidth="0.0" prefWidth="0.0" HBox.hgrow="ALWAYS"/>
            </HBox>
        </StackPane>
    </center>

    <right>
        <ScrollPane fx:id="sidebarScroll" styleClass="sidebar-scroll" fitToWidth="true"
                    hbarPolicy="NEVER" vbarPolicy="NEVER"
                    minWidth="0.0" prefWidth="0.0" maxWidth="0.0">
            <content>
                <VBox fx:id="controlHost"/>
            </content>
        </ScrollPane>
    </right>

</BorderPane>
