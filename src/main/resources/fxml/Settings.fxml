<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" styleClass="stub-screen" spacing="16.0" alignment="TOP_LEFT"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.SettingsController">
    <padding>
        <Insets top="40" right="64" bottom="40" left="64"/>
    </padding>

    <Button styleClass="back-button" text="← Menu" onAction="#handleBack"/>
    <Label styleClass="stub-title" text="Settings"/>

    <Label fx:id="currentThemeLabel" styleClass="stub-body" text="Current theme: dark"/>
    <Button fx:id="toggleThemeButton" styleClass="primary-button" text="Switch to Light"
            onAction="#handleToggleTheme"/>

    <Label styleClass="stub-body" text="Accessibility"/>
    <CheckBox fx:id="reducedMotionCheck" text="Reduced motion — disable trails, glow, and transitions"
              onAction="#handleToggleReducedMotion"/>
    <CheckBox fx:id="colorBlindCheck" text="Colour-blind-safe bob palette (Okabe-Ito)"
              onAction="#handleToggleColorBlindSafe"/>
    <Label styleClass="stub-body"
           text="Takes effect the next time the simulation screen opens."/>

    <Label styleClass="stub-body"
           text="More preferences — default link count, gravity, angle units — land here in a future phase."/>
</VBox>
