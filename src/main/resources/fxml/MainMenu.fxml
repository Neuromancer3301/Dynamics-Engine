<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" styleClass="main-menu-root"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.MainMenuController">

    <top>
        <HBox styleClass="menu-header-row" spacing="24.0" alignment="TOP_LEFT">
            <padding>
                <Insets top="48" right="64" bottom="8" left="64"/>
            </padding>

            <VBox styleClass="menu-header" spacing="6.0" HBox.hgrow="ALWAYS">
                <Label styleClass="app-title" text="Dynamics Engine"/>
                <Label styleClass="app-tagline"
                       text="An instrument for exploring chaotic dynamical systems in real time."/>
            </VBox>

            <!-- Settings/About: deliberately not cards here — they're utility
                 destinations, not simulations, so they read as understated
                 relative to the hero grid below. Populated in Java
                 (component.UtilityIconButton) rather than declared here,
                 since they're hand-rolled Canvas-icon buttons, not a type
                 FXML has a tag for — see controller.MainMenuController. -->
            <HBox fx:id="utilityLinksBox" spacing="4.0" alignment="TOP_RIGHT"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="28.0">
            <Label styleClass="menu-section-label" text="CHOOSE A SIMULATION"/>

            <HBox styleClass="cards-row" spacing="28.0" alignment="CENTER">
                <padding>
                    <Insets top="0" right="48" bottom="24" left="48"/>
                </padding>

                <fx:include fx:id="cardPendulum" source="component/NavCard.fxml"/>
                <fx:include fx:id="cardSlotTwo" source="component/NavCard.fxml"/>
                <fx:include fx:id="cardSlotThree" source="component/NavCard.fxml"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <Label fx:id="versionLabel" styleClass="footer-text" text="v1.0.4"
               BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="16"/>
            </BorderPane.margin>
        </Label>
    </bottom>

</BorderPane>
