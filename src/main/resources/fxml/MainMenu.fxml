<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" styleClass="main-menu-root"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.MainMenuController">

    <top>
        <HBox styleClass="menu-header-row" spacing="24.0" alignment="TOP_LEFT">
            <padding>
                <Insets top="48" right="64" bottom="8" left="64"/>
            </padding>

            <VBox styleClass="menu-header" spacing="6.0" HBox.hgrow="ALWAYS">
                <Label styleClass="eyebrow" text="JAVAFX · RK4 · LAGRANGIAN MECHANICS"/>
                <Label styleClass="app-title" text="Dynamics Engine"/>
                <Label styleClass="app-tagline"
                       text="An instrument for exploring chaotic dynamical systems in real time."/>
            </VBox>

            <!-- Settings/About: deliberately not cards here — they're utility
                 destinations, not simulations, so they read as quiet corner
                 links rather than competing with the hero grid below for
                 attention. See controller.MainMenuController for the click
                 wiring (a plain Label, not a Button, so it can match the
                 hero grid's monospace "meta" typography exactly). -->
            <HBox styleClass="menu-utility-links" spacing="20.0" alignment="TOP_RIGHT">
                <Label fx:id="settingsLink" styleClass="menu-utility-link" text="⚙ Settings"/>
                <Label fx:id="aboutLink" styleClass="menu-utility-link" text="ℹ About"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="16.0">
            <Label styleClass="menu-section-label" text="CHOOSE A SIMULATION"/>

            <HBox styleClass="cards-row" spacing="24.0" alignment="CENTER">
                <padding>
                    <Insets top="0" right="64" bottom="56" left="64"/>
                </padding>

                <fx:include fx:id="cardPendulum" source="component/NavCard.fxml"/>
                <fx:include fx:id="cardSlotTwo" source="component/NavCard.fxml"/>
                <fx:include fx:id="cardSlotThree" source="component/NavCard.fxml"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <Label fx:id="versionLabel" styleClass="footer-text" text="v1.0.0"
               BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="16"/>
            </BorderPane.margin>
        </Label>
    </bottom>

</BorderPane>
