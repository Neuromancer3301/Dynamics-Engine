<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Mechanical copy of Simulation.fxml's structure (n-body implementation
    spec §9) — same @FXML field names/types controller.NBodySimulationController
    expects, same layout shape (action rail / canvas+graph stack / collapsible
    sidebar). graphHost exists here purely because ui.simcore.LayoutShell's
    constructor requires one; NBodySimulationController never calls
    LayoutShell#setGraphVisible, so it stays permanently collapsed — there is
    no Graphs tab for this screen (see the spec §8).
-->
<BorderPane fx:id="root" styleClass="simulation-root"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.NBodySimulationController">

    <top>
        <HBox styleClass="sim-title-bar" alignment="CENTER_LEFT" spacing="12.0">
            <padding>
                <Insets top="6" right="12" bottom="6" left="6"/>
            </padding>
            <Button fx:id="btnBack" styleClass="back-button" text="← Menu" onAction="#handleBack"/>
            <Label fx:id="titleLabel" styleClass="sim-title" text="N-Body Gravity Simulator"/>
        </HBox>
    </top>

    <left>
        <VBox fx:id="actionRail" styleClass="action-rail" alignment="TOP_CENTER" spacing="6.0"/>
    </left>

    <center>
        <StackPane fx:id="canvasGraphStack" BorderPane.alignment="CENTER">
            <HBox fx:id="canvasGraphRow" spacing="0">
                <StackPane fx:id="canvasHost" styleClass="canvas-host"
                           minWidth="0.0" prefWidth="0.0" HBox.hgrow="ALWAYS"/>
                <StackPane fx:id="graphHost" styleClass="canvas-host"
                           minWidth="0.0" prefWidth="0.0" maxWidth="0.0" HBox.hgrow="NEVER"/>
            </HBox>
        </StackPane>
    </center>

    <right>
        <ScrollPane fx:id="sidebarScroll" styleClass="sidebar-scroll" fitToWidth="true"
                    hbarPolicy="NEVER" vbarPolicy="NEVER"
                    minWidth="0.0" prefWidth="0.0" maxWidth="0.0">
            <content>
                <VBox fx:id="controlHost"/>
            </content>
        </ScrollPane>
    </right>

</BorderPane>
